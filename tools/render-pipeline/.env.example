# Higgsfield API credentials — get from https://cloud.higgsfield.ai/
# Option A: separate key and secret
HF_API_KEY=your-api-key-here
HF_API_SECRET=your-api-secret-here

# Option B: combined format (key:secret)
# HF_KEY=your-api-key:your-api-secret

# Claude Vision (for render scoring) — same key as visual-check tool
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: Higgsfield API base URL override (default: https://api.higgsfield.ai/v1)
# HF_BASE_URL=https://api.higgsfield.ai/v1
